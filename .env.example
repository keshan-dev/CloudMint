# CloudMint Environment Configuration Template
# Copy this file to .dev.vars for local testing with `wrangler pages dev`

# Cloudflare Turnstile Keys
# Note: Site Key is public; Secret Key MUST remain strictly server-side
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Rotwatch Audit Integration Key (Used for authorized batch verification without Turnstile captcha)
ROTWATCH_AUDIT_KEY=rotwatch-audit-secret-key-placeholder
ROTWATCH_VERIFICATION_TOKEN=rotwatch-verify-cm-78291
